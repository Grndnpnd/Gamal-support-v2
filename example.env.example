# ── Required ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_token_here

# ── Bankr LLM Gateway ─────────────────────────────────────────────────────────
# Get your key at bankr.bot/api — enable "LLM Gateway" permission on the key
# Top up credits at bankr.bot/llm before first use (new accounts start at $0)
BANKR_LLM_KEY=bk_your_key_here
BANKR_LLM_URL=https://llm.bankr.bot
BANKR_LLM_MODEL=gemini-3-flash

# ── Docs ──────────────────────────────────────────────────────────────────────
DOCS_URL=https://docs.bankr.bot/llms-full.txt
DOCS_REFRESH_HOURS=6

# ── Channels (comma-separated IDs, leave empty to monitor all) ────────────────
MONITORED_CHANNEL_IDS=

# ── Conversation ──────────────────────────────────────────────────────────────
CONVERSATION_TTL_MINUTES=30
REFLAG_COOLDOWN_MINUTES=15

# ── Semantic search tuning ────────────────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K_CHUNKS=6
MAX_RETRIEVED_CHARS=8000

# ── Plain Support Integration ─────────────────────────────────────────────────
# Get this from Plain: Settings → Machine Users → Add Machine User → Add API Key
# Required permissions: customer:create, customer:edit, thread:create, thread:read, threadReply:create
PLAIN_API_KEY=plainApiKey_xxx

# Optional: a Plain label type ID to tag all Discord tickets (e.g. "Discord")
# Find label type IDs in Plain: Settings → Labels
PLAIN_LABEL_TYPE_ID=

# ── Redis (required for Railway production) ───────────────────────────────────
# Railway auto-injects this when you add a Redis database service to your project.
# Leave blank for local development — falls back to in-memory dict automatically.
REDIS_URL=

# ── Plain Webhook Server ──────────────────────────────────────────────────────
# Port for the webhook receiver (webhook_server.py)
# Point your Plain webhook target at: https://YOUR_HOST/plain-webhook
WEBHOOK_PORT=8080

# Optional: shared secret for Plain webhook signature verification
PLAIN_WEBHOOK_SECRET=

# ── Agent API Server ──────────────────────────────────────────────────────────
# Secret key external agents must send as Bearer token
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
API_SERVER_KEY=your_secret_key_here

# Port for the agent API server (api_server.py)
API_SERVER_PORT=8000
